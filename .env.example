# Server Configuration
PORT=8000
HOST=0.0.0.0

# AI Models API Keys (Groq recommended)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback AI Model API Key (Optional)
GEMINI_API_KEY=your_gemini_api_key_here

# Database URL (Defaults to local SQLite file)
DATABASE_URL=sqlite:///./qms_complaints.db

# Frontend API Base URL (Only required if deploying Frontend & Backend separately)
# Example: https://my-qms-backend.onrender.com
VITE_API_BASE_URL=

# Allowed Origins for CORS (Comma-separated for separate host deployment)
ALLOWED_ORIGINS=*
